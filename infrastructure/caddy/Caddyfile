# Proxy HTTPS de producción. Caddy obtiene y renueva solo el certificado de Let's Encrypt
# para APP_DOMAIN y reenvía todo al contenedor web (Nginx), que sirve Angular y /api.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	reverse_proxy web:80
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
}
