# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
DB_NAME=nuvyra
DB_USER=nuvyra
DB_PASSWORD=cambia-esta-clave

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_TIME_ZONE=America/Lima
WEB_PORT=8080

# Sesión. En producción (HTTPS) deja los valores por defecto: __Host-sid y Secure=true.
# Solo para probar por HTTP en localhost:
APP_SESSION_COOKIE_NAME=sid
APP_SESSION_COOKIE_SECURE=false

# Secreto para los enlaces de renovación (mínimo 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48   — cambiarlo invalida los enlaces ya enviados.
APP_RENEWAL_TOKEN_SECRET=reemplaza-por-un-valor-aleatorio-de-al-menos-32-caracteres

# Clave AES-256 (32 bytes en Base64) para cifrar credenciales de terceros, como los tokens de WhatsApp.
# Genera una con: openssl rand -base64 32   — si la cambias, los negocios deben volver a guardar su token.
APP_SECRETS_ENCRYPTION_KEY=reemplaza-por-una-clave-base64-de-32-bytes

# --- WhatsApp Business Platform (opcional) ---
# App de Meta de la plataforma: el secreto valida la firma de los webhooks y el token responde a su alta.
# Sin ellos los avisos se envían igual, pero no se registran entregas ni respuestas por botón.
APP_WHATSAPP_APP_SECRET=
APP_WHATSAPP_VERIFY_TOKEN=

# Documentación OpenAPI en /api/docs (desactivar en producción)
APP_OPENAPI_ENABLED=false

# --- Correo (recuperación de contraseña). Sin SMTP no se envían correos. ---
APP_MAIL_FROM=no-reply@tudominio.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Superadministrador inicial (se crea una sola vez al arrancar) ---
APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
